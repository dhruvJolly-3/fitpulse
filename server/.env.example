# Copy to server/.env for local development. Never commit the real .env.

# Render injects PORT automatically in production; 5001 is the local default.
PORT=5001

# MongoDB connection string (Atlas: Database > Connect > Drivers).
# MONGO_URI is also accepted for older .env files.
MONGODB_URI=mongodb://localhost:27017/fitpulse

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated frontend origins allowed to call the API (no trailing slash).
# http://localhost:3000 is always allowed, so this can stay empty locally.
CORS_ORIGINS=

NODE_ENV=development

# ---- Optional features (each one is switched off until its vars are set) ----

# Frontend URL used in password-reset emails (no trailing slash).
APP_URL=http://localhost:3000

# SMTP for password-reset emails. Without SMTP_HOST the link is only logged.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char App Password from myaccount.google.com/apppasswords>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FitPulse <no-reply@example.com>"

# Google Sign-In: OAuth 2.0 Client ID (Web) from Google Cloud Console.
# Must match the client's REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# YouTube Data API v3 key for exercise demo videos.
YOUTUBE_API_KEY=

# TheMealDB key for recipes. "1" is the free test key.
MEALDB_API_KEY=1

# Food database: Open Food Facts needs no key. Override only for testing.
# OFF_BASE_URL=https://world.openfoodfacts.org

# Smart reminders by Web Push (website). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# The client reads the public key from the API, so nothing to set on Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Fitbit (Google) sync: dev.fitbit.com → Register an app, OAuth 2.0 type "Server",
# callback URL = <this API's URL>/api/integrations/fitbit/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=https://your-api.onrender.com/api/integrations/fitbit/callback
