# Copy to client/.env.local to point the frontend at a different backend.
# Leave unset for local dev — it falls back to http://localhost:5001.
# Create React App inlines REACT_APP_* variables at BUILD time, so changing
# this on Vercel requires a redeploy.
REACT_APP_API_URL=http://localhost:5001

# Optional: Google Sign-In. OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. Add your site
# (e.g. https://fitpulse-ruddy.vercel.app and http://localhost:3000) under
# "Authorized JavaScript origins". The server needs the same value as
# GOOGLE_CLIENT_ID. Leave unset to hide the Google button.
REACT_APP_GOOGLE_CLIENT_ID=

# Optional: Spotify inside FitPulse (playlists, Liked Songs, play/pause/skip).
# developer.spotify.com/dashboard → Create app → tick "Web API" + "Web Playback SDK"
# → Redirect URIs: https://<your-site>/spotify-callback and
# http://127.0.0.1:3000/spotify-callback. Users need Spotify Premium.
REACT_APP_SPOTIFY_CLIENT_ID=
